https://leetcode.com/problems/count-primes/

class Solution(object):
    def countPrimes(self, n):
        """
        :type n: int
        :rtype: int
        """

        count = 0
        l = []
        for i in range(n):
            l.append(1)

        for i in range(2, int(n**0.5) +1):
            if l[i] == 1:
                for j in range(i*i , n, i):
                    l[j] = 0
        
        for i in range(2, n):
            if l[i] == 1:
                count += 1

        return count