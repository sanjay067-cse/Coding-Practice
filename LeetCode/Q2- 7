https://leetcode.com/problems/reverse-integer/

class Solution(object):
    def reverse(self, x):
        """
        :type x: int
        :rtype: int
        """
        rev = 0
        if x >= 0 :
            while x!= 0:
                d = x % 10
                rev = rev * 10 + d
                x = x/10
            if rev > -(2**31) and rev < (2**31)-1 :
                return rev
            else: 
                return 0

        else :
            x = abs(x)
            while x!= 0:
                d = x % 10
                rev = rev * 10 + d
                x = x/10
            if rev >= -(2**31) and rev < (2**31)-1 :
                return -rev
            else: 
                return 0

    